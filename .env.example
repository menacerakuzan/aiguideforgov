# ─────────────────────────────────────────────────────────────────────────────
# Шаблон змінних середовища. Скопіюйте у .env (він у .gitignore).
#
# Файл ОДИН — у корені монорепо. Next сам його не знайшов би (шукає лише у своїй
# теці), тому скрипти apps/web загорнуті в `dotenv -e ../../.env`, як і скрипти
# prisma. Раніше копію тримали ще й у apps/web — копії розʼїжджалися, і
# несходження BETTER_AUTH_SECRET ламало сесії без жодної помилки в логах.
# ─────────────────────────────────────────────────────────────────────────────

# База даних (SQLite, файл створюється автоматично при міграції).
# Шлях відносний до prisma/schema.prisma, а не до поточної теки.
DATABASE_URL="file:./dev.db"

# ── Better Auth ──────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET підписує сесійні куки й токени відновлення пароля.
# Значення нижче — НЕ секрет: воно лежить у git і однакове в усіх, хто склонував
# репозиторій. Згенеруйте власне:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# У продакшні застосунок із цим шаблонним значенням не стартує — див.
# services/infra/src/env.ts. У розробці лише попереджає в консоль.
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Базова адреса застосунку. У продакшні обовʼязкова й мусить бути https —
# від неї залежить, які origin'и приймає автентифікація.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Додаткові довірені origin'и через кому — стенд, прев'ю, окремий домен.
# Порожньо, якщо застосунок відкривають лише за BETTER_AUTH_URL.
TRUSTED_ORIGINS=""

# ── Підтримка ────────────────────────────────────────────────────────────────
# Адреса, на яку людина пише, щоб відновити пароль. Показується на сторінці
# /forgot-password і підставляється в готовий лист. Поки що це і є весь
# механізм відновлення — автоматичного скидання за посиланням немає, бо немає
# поштового провайдера (services/infra/src/mailer.ts пише лише в консоль).
NEXT_PUBLIC_SUPPORT_EMAIL="support@pro-ai.gov.ua"

# ── Адміністратор ────────────────────────────────────────────────────────────
# Єдиний адміністратор платформи. Його створює `pnpm db:seed` (разом із базою)
# і `pnpm db:create-admin` (на вже робочій базі, нічого не стираючи).
#
# Демо-акаунтів із відомим паролем платформа більше не створює: у продакшні це
# просто чорний хід. Слухачі реєструються самі.
#
# Пароль — мінімум 12 символів, без очевидних слів на початку. Згенерувати:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
#
# Якщо адміністратор загубить пароль, повернути доступ можна лише
# `pnpm db:create-admin` на сервері — автоматичного відновлення немає.
#
# Ці змінні потрібні ЛИШЕ скриптам бази. У юніті systemd вони прибираються
# рядком `UnsetEnvironment=` — інакше EnvironmentFile віддав би пароль
# адміністратора оточенню веб-процесу, якому він не потрібен.
#
# ADMIN_PASSWORD можна не тримати тут узагалі: якщо змінна порожня,
# `db:seed` і `db:create-admin` спитають пароль із клавіатури (двічі, без
# показу на екрані).
ADMIN_EMAIL="admin@example.gov.ua"
ADMIN_PASSWORD=""
# Необовʼязково; за замовчуванням «Адміністратор платформи».
ADMIN_NAME=""
