# ─────────────────────────────────────────────────────────────────────────────
# Шаблон змінних середовища. Скопіюйте у .env (він у .gitignore).
#
# УВАГА: .env потрібен у ДВОХ місцях — у корені (його читають скрипти prisma)
# і в apps/web (його читає Next). BETTER_AUTH_SECRET в обох мусить збігатися,
# інакше сесія, видана одним процесом, не пройде перевірку в іншому.
# ─────────────────────────────────────────────────────────────────────────────

# База даних (SQLite, файл створюється автоматично при міграції).
# Шлях відносний до prisma/schema.prisma, а не до поточної теки.
DATABASE_URL="file:./dev.db"

# ── Better Auth ──────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET підписує сесійні куки й токени відновлення пароля.
# Значення нижче — НЕ секрет: воно лежить у git і однакове в усіх, хто склонував
# репозиторій. Згенеруйте власне:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# У продакшні застосунок із цим шаблонним значенням не стартує — див.
# services/infra/src/env.ts. У розробці лише попереджає в консоль.
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Базова адреса застосунку. У продакшні обовʼязкова й мусить бути https —
# від неї залежить, які origin'и приймає автентифікація.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Додаткові довірені origin'и через кому — стенд, прев'ю, окремий домен.
# Порожньо, якщо застосунок відкривають лише за BETTER_AUTH_URL.
TRUSTED_ORIGINS=""
