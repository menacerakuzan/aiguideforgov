{
  "name": "@proai/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../.env -- tsx src/seed.ts",
    "sync-content": "dotenv -e ../.env -- tsx src/sync-content.ts",
    "sync-courses": "dotenv -e ../.env -- tsx src/sync-courses.ts",
    "fix-legacy-data": "dotenv -e ../.env -- tsx src/fix-legacy-data.ts",
    "sync-quiz": "dotenv -e ../.env -- tsx src/sync-quiz.ts",
    "sync-library": "dotenv -e ../.env -- tsx src/sync-library.ts",
    "create-admin": "dotenv -e ../.env -- tsx src/create-admin.ts",
    "create-demo": "dotenv -e ../.env -- tsx src/create-demo.ts",
    "split-course": "dotenv -e ../.env -- tsx src/split-course.ts",
    "export-lessons": "dotenv -e ../.env -- tsx src/export-lessons.ts",
    "audit-lessons": "tsx src/audit-lessons.ts",
    "audit-quiz": "tsx src/audit-quiz.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "schema.prisma",
    "seed": "dotenv -e ../.env -- tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "@proai/infra": "workspace:*",
    "better-auth": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@proai/config": "workspace:*",
    "@proai/types": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
