# ── Медіа ────────────────────────────────────────────────────────────────────
# Готова продукція уроку: відео + скріншоти, по теці на урок.
# Поза git: важке й переспівується зі studio/out. Це та сама тека, яку копіюють
# на іншу машину разом із prisma/dev.db, щоб платформа була повною.
apps/web/public/media/

# Матеріали уроку для завантаження (звіт, чек-листи) лишаються в git:
# вони легкі, авторські й міняються разом із текстом уроку, а не з пересъемкою.
#   apps/web/public/lessons/**  — НЕ ігноруємо

# ── Майстерня ────────────────────────────────────────────────────────────────
# Скрипти зйомки й монтажу версіонуються: це єдина невідновлювана частина, у них
# зашитий весь досвід із пастками. Важке — ні.
studio/node_modules/
studio/out/
studio/edit/node_modules/
studio/edit/out/
# вихідні матеріали монтажу: дубль, озвучка — копії того, що лежить у out/
studio/edit/public/
# Промо-ролик сервісу — те саме правило. Знімки сторінок важать десятки
# мегабайтів і відтворюються `npm run capture` за хвилину; озвучка — `tts.mjs`.
# Невідновлюване тут лише те, що в src/ і scripts/.
studio/promo/node_modules/
studio/promo/out/
studio/promo/public/
# тимчасові файли Word, поки документ відкрито
~$*

.generate/

# Профіль Chrome для зйомки — це кеш браузера, а не вихідний код.
# Окремим рядком ловимо теку з буквальним windows-шляхом у назві: вона
# зʼявлялася, коли studio/-скрипти запускали не на Windows (див. studio/lib/paths.mjs).
studio/.chrome-profile/
C:\\*

# os / editor
.DS_Store
*.log
