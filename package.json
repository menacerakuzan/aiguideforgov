{
  "name": "proai",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @proai/db generate",
    "db:migrate": "pnpm --filter @proai/db migrate",
    "db:seed": "pnpm --filter @proai/db seed",
    "db:sync-content": "pnpm --filter @proai/db sync-content",
    "db:sync-courses": "pnpm --filter @proai/db sync-courses",
    "db:sync-quiz": "pnpm --filter @proai/db sync-quiz",
    "db:sync-library": "pnpm --filter @proai/db sync-library",
    "db:create-admin": "pnpm --filter @proai/db create-admin",
    "db:reset": "pnpm --filter @proai/db reset"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
